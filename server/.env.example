# Copy to .env for local development. Production sets real env vars.
DATABASE_URL=postgresql://localhost/stanzabonanza
# Comma-separated. Empty in production (same-origin SPA); Vite dev uses
# a proxy, so this is only needed if you call the API cross-origin.
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
